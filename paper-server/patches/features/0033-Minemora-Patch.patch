+                    Rotations.CODEC.optionalFieldOf("Body", ArmorStandMonster.DEFAULT_BODY_POSE).forGetter(ArmorStandMonster.ArmorStandPose::body),
+                    Rotations.CODEC.optionalFieldOf("LeftArm", ArmorStandMonster.DEFAULT_LEFT_ARM_POSE).forGetter(ArmorStandMonster.ArmorStandPose::leftArm),
+                    Rotations.CODEC.optionalFieldOf("RightArm", ArmorStandMonster.DEFAULT_RIGHT_ARM_POSE).forGetter(ArmorStandMonster.ArmorStandPose::rightArm),
+                    Rotations.CODEC.optionalFieldOf("LeftLeg", ArmorStandMonster.DEFAULT_LEFT_LEG_POSE).forGetter(ArmorStandMonster.ArmorStandPose::leftLeg),
+                    Rotations.CODEC.optionalFieldOf("RightLeg", ArmorStandMonster.DEFAULT_RIGHT_LEG_POSE).forGetter(ArmorStandMonster.ArmorStandPose::rightLeg)
+                )
+                .apply(instance, ArmorStandMonster.ArmorStandPose::new)
+        );
+    }
